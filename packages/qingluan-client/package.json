{
  "name": "qingluan-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Qingluan terminal gRPC client: lease, reconnect, cursors, rich-error decode",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "bash scripts/generate.sh",
    "typecheck": "pnpm run generate && tsc --project tsconfig.json --noEmit",
    "build": "pnpm run generate && tsc --project tsconfig.json",
    "test": "pnpm run build && node --test 'dist/*.test.js'"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.1",
    "@grpc/grpc-js": "1.14.5"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "ts-proto": "2.12.4",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.21.0"
}
